FROM python:3.12-slim

ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    unzip \
    curl \
    gcc \
    libpq-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install OpenStack CLI
RUN pip install --no-cache-dir python-openstackclient

# Install OpenTofu
ARG OPENTOFU_VERSION=1.13.1
RUN wget https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_amd64.zip \
    && unzip tofu_${OPENTOFU_VERSION}_linux_amd64.zip \
    && mv tofu /usr/local/bin/ \
    && rm tofu_${OPENTOFU_VERSION}_linux_amd64.zip

# Install Packer
ARG PACKER_VERSION=1.10.0
RUN wget https://releases.hashicorp.com/packer/${PACKER_VERSION}/packer_${PACKER_VERSION}_linux_amd64.zip \
    && unzip packer_${PACKER_VERSION}_linux_amd64.zip \
    && mv packer /usr/local/bin/ \
    && rm packer_${PACKER_VERSION}_linux_amd64.zip

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ln -s /root/.local/bin/poetry /usr/local/bin/poetry

# Copy Poetry files and install dependencies
COPY pyproject.toml ./
RUN poetry install --no-root --no-interaction --no-ansi

# Copy application code
COPY . .

# Create temp directory for repositories
RUN mkdir -p /tmp/worker_repos

# Job-Slots laufen wie in Prod unter eigener UID (siehe app/job_context.py).
RUN mkdir -p /var/lib/appstore-worker && chmod 0711 /tmp/worker_repos /var/lib/appstore-worker
ENV WORKER_JOB_UID_BASE=20000

# Worker starten: LISTEN task_queued, Jobs aus der Postgres-Queue
CMD ["poetry", "run", "python", "-m", "app"]
