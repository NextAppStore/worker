# Virtual Environment
# Critical: the host .venv is a macOS/arm64 venv. Copying it into the
# image masks the Linux venv built by `poetry install` and every console
# script keeps its /Users/... shebang.
venv/
env/
.venv/
ENV/

# Environment Files
.env
.env.*
!.env.example

